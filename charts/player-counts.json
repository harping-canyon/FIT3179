{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Player support hierarchy for all 871 games or the 14 matched Spiel des Jahres main-award winners from 1979–2024. Each selected game appears once.",
  "width": 850,
  "height": 390,
  "padding": 0,
  "autosize": "none",
  "config": {
    "font": "Inter"
  },
  "data": [
    {
      "name": "tree",
      "url": "./data/player_tree_awards.json",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.scope == awardScope"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "n",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "paddingInner": 3,
          "paddingTop": 28,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "parents",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 2"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "datum.parent == 'solo' ? '#176c7a' : '#dce2dd'"
          },
          "tooltip": {
            "signal": "{'Play mode': datum.parent == 'solo' ? 'Solo option' : 'Needs company', 'Maximum supported': datum.label, 'Games': datum.n, 'Share of selected games': format(datum.n/cohortTotal, '.1%'), 'Cohort': awardScope == 'all' ? 'All 871 story games' : '14 Spiel des Jahres winners (1979–2024)'}"
          },
          "stroke": {
            "value": "#fffefa"
          },
          "strokeWidth": {
            "value": 0
          }
        },
        "hover": {
          "stroke": {
            "value": "#243238"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 + -11"
          },
          "text": {
            "signal": "datum.label"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 500
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "signal": "datum.parent == 'solo' ? '#fffefa' : '#243238'"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0 > 48 && datum.y1-datum.y0 > 44 ? 1 : 0"
          },
          "limit": {
            "signal": "max(0, datum.x1-datum.x0-8)"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 + 12"
          },
          "text": {
            "field": "n"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 22
          },
          "fontWeight": {
            "value": 600
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "signal": "datum.parent == 'solo' ? '#fffefa' : '#243238'"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0 > 48 && datum.y1-datum.y0 > 44 ? 1 : 0"
          },
          "limit": {
            "signal": "max(0, datum.x1-datum.x0-8)"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "parents"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0",
            "offset": 3
          },
          "y": {
            "field": "y0",
            "offset": 15
          },
          "text": {
            "signal": "datum.x1-datum.x0 < 180 ? (datum.id == 'solo' ? 'Solo, ' : 'Company, ') + datum.total : datum.label + ', ' + datum.total + (datum.total == 1 ? ' game' : ' games')"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#243238"
          },
          "limit": {
            "signal": "max(0, datum.x1-datum.x0-6)"
          }
        }
      }
    }
  ],
  "signals": [
    {
      "name": "awardScope",
      "value": "all",
      "bind": {
        "input": "select",
        "name": "Show player counts for: ",
        "options": [
          "all",
          "winners"
        ],
        "labels": [
          "All 871 games",
          "14 Spiel des Jahres winners"
        ]
      }
    },
    {
      "name": "cohortTotal",
      "update": "awardScope == 'all' ? 871 : 14"
    }
  ],
  "usermeta": {
    "sources": [
      "BoardGameGeek",
      "Spiel des Jahres e.V."
    ],
    "join": "Main-award records matched to BGG games before rebuilding the player-support hierarchy",
    "awardScope": "1979–2024 main award only; 14 matches from 46 source winners. Denominators and parent totals change with the selected cohort."
  }
}
