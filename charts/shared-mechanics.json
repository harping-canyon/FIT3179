{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#526369",
      "titleColor": "#526369",
      "gridColor": "#edf0ee"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "font": "Inter"
  },
  "height": 390,
  "layer": [
    {
      "data": {
        "url": "./data/mechanic_edges.json"
      },
      "mark": {
        "type": "rule"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -1.65,
              1.65
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -1.4,
              1.3
            ],
            "reverse": true
          }
        },
        "x2": {
          "field": "x2"
        },
        "y2": {
          "field": "y2"
        },
        "strokeWidth": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              101
            ],
            "range": [
              0,
              9
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "source",
            "title": "First mechanic"
          },
          {
            "field": "target",
            "title": "Second mechanic"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Games using both"
          }
        ],
        "color": {
          "condition": {
            "test": "mechanicFocus == 'All mechanics' ? datum.n == 101 : datum.source == mechanicFocus || datum.target == mechanicFocus",
            "value": "#176c7a"
          },
          "value": "#b6c0ba"
        },
        "opacity": {
          "condition": {
            "test": "mechanicFocus == 'All mechanics' ? datum.n == 101 : datum.source == mechanicFocus || datum.target == mechanicFocus",
            "value": 0.85
          },
          "value": 0.4
        }
      }
    },
    {
      "data": {
        "url": "./data/mechanic_nodes.json"
      },
      "mark": {
        "type": "circle",
        "color": "#176c7a",
        "opacity": 1,
        "stroke": "#fffefa",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -1.65,
              1.65
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -1.4,
              1.3
            ],
            "reverse": true
          }
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              281
            ],
            "range": [
              0,
              1400
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Mechanic"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Games"
          }
        ],
        "color": {
          "condition": {
            "test": "mechanicFocus == 'All mechanics' || datum.label == mechanicFocus",
            "value": "#176c7a"
          },
          "value": "#a2bfc1"
        }
      }
    },
    {
      "data": {
        "url": "./data/mechanic_nodes.json"
      },
      "transform": [
        {
          "calculate": "abs(datum.x) > 0.8 ? datum.y : datum.y < -0.9 ? datum.y - 0.36 : datum.y + 0.25",
          "as": "labelY"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1f3035",
        "align": {
          "expr": "datum.x < -0.8 ? 'right' : datum.x > 0.8 ? 'left' : 'center'"
        },
        "dx": {
          "expr": "datum.x < -0.8 ? -27 : datum.x > 0.8 ? 27 : 0"
        },
        "dy": {
          "expr": "abs(datum.x) > 0.8 ? -6 : 0"
        },
        "stroke": "#fffefa",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -1.65,
              1.65
            ]
          }
        },
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "axis": null
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "./data/mechanic_nodes.json"
      },
      "transform": [
        {
          "calculate": "abs(datum.x) > 0.8 ? datum.y : datum.y < -0.9 ? datum.y - 0.36 : datum.y + 0.25",
          "as": "labelY"
        },
        {
          "calculate": "datum.n + ' games'",
          "as": "countLabel"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 400,
        "color": "#526369",
        "dy": {
          "expr": "abs(datum.x) > 0.8 ? 12 : 17"
        },
        "align": {
          "expr": "datum.x < -0.8 ? 'right' : datum.x > 0.8 ? 'left' : 'center'"
        },
        "dx": {
          "expr": "datum.x < -0.8 ? -27 : datum.x > 0.8 ? 27 : 0"
        },
        "stroke": "#fffefa",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -1.65,
              1.65
            ]
          }
        },
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "axis": null
        },
        "text": {
          "field": "countLabel",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "./data/mechanic_edges.json"
      },
      "transform": [
        {
          "filter": "datum.n == 101 && (mechanicFocus == 'All mechanics' || datum.source == mechanicFocus || datum.target == mechanicFocus)"
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",
          "as": "labelX"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2 - 0.2",
          "as": "labelY"
        }
      ],
      "mark": {
        "type": "text",
        "color": "#176c7a",
        "fontWeight": 700,
        "fontSize": 13,
        "stroke": "#f8f6f0",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "labelX",
          "type": "quantitative",
          "axis": null
        },
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "axis": null
        },
        "text": {
          "value": "101 games use both"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "size": "independent",
      "strokeWidth": "independent"
    }
  },
  "params": [
    {
      "name": "mechanicFocus",
      "value": "All mechanics",
      "bind": {
        "input": "select",
        "name": "Trace connections: ",
        "options": [
          "All mechanics",
          "Managing a hand",
          "Collecting sets",
          "Choosing from a shared pool",
          "Competing for influence",
          "Rolling dice"
        ],
        "labels": [
          "All five mechanics",
          "Managing a hand",
          "Collecting sets",
          "Choosing from a shared pool",
          "Competing for influence",
          "Rolling dice"
        ]
      }
    }
  ]
}
