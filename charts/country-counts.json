{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Unique games with an explicit Country: family tag. Circle area encodes the number of games associated with each mapped country; country positions come from Natural Earth 5.1.1.",
  "width": "container",
  "height": 350,
  "padding": 0,
  "background": "transparent",
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "./data/world.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8eae6",
        "stroke": "#ffffff",
        "strokeWidth": 0.55
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "MultiLineString",
            "coordinates": [
              [
                [
                  -13,
                  35
                ],
                [
                  -13,
                  61
                ],
                [
                  30,
                  61
                ],
                [
                  30,
                  35
                ],
                [
                  -13,
                  35
                ]
              ]
            ]
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#9a6a35",
        "strokeWidth": 1.2,
        "strokeDash": [
          4,
          3
        ]
      }
    },
    {
      "data": {
        "url": "./data/countries.json"
      },
      "transform": [
        {
          "filter": "isValid(datum.longitude) && isValid(datum.latitude)"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#176c7a",
        "fillOpacity": 0.77,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "game_count",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              128
            ],
            "range": [
              0,
              600
            ]
          },
          "legend": {
            "title": "Games",
            "values": [
              10,
              50,
              100
            ],
            "orient": "bottom-left"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Place"
          },
          {
            "field": "game_count",
            "type": "quantitative",
            "title": "Tagged games"
          },
          {
            "field": "example_titles",
            "type": "nominal",
            "title": "Examples"
          }
        ]
      }
    },
    {
      "data": {
        "url": "./data/countries.json"
      },
      "transform": [
        {
          "filter": "indexof(['US','JP'], datum.iso) >= 0"
        },
        {
          "calculate": "(datum.iso === 'US' ? 'US' : datum.country) + ', ' + datum.game_count",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -20,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#163c46",
        "stroke": "#fbfbf8",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#435158",
      "titleColor": "#435158"
    },
    "font": "Inter"
  }
}
