{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 400,
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#526369",
      "titleColor": "#526369",
      "gridColor": "#edf0ee"
    },
    "font": "Inter"
  },
  "data": {
    "url": "./data/games.json"
  },
  "encoding": {
    "x": {
      "field": "complexity",
      "type": "quantitative",
      "title": "Community-rated complexity (1–5)",
      "scale": {
        "domain": [
          1,
          5
        ]
      },
      "axis": {
        "tickCount": 7
      }
    },
    "y": {
      "field": "rating",
      "type": "quantitative",
      "title": "Average user rating (1–10)",
      "scale": {
        "domain": [
          4,
          10
        ]
      },
      "axis": {
        "tickCount": 6
      }
    },
    "tooltip": [
      {
        "field": "title",
        "type": "nominal",
        "title": "Game"
      },
      {
        "field": "complexity",
        "type": "quantitative",
        "format": ".2f",
        "title": "Complexity (1–5)"
      },
      {
        "field": "rating",
        "type": "quantitative",
        "format": ".2f",
        "title": "User rating (1–10)"
      },
      {
        "field": "rating_votes",
        "type": "quantitative",
        "title": "Rating votes",
        "format": ","
      },
      {
        "field": "award_label",
        "type": "nominal",
        "title": "Main award"
      }
    ]
  },
  "params": [
    {
      "name": "gameFocus",
      "value": 9209,
      "bind": {
        "input": "select",
        "name": "Highlight an example: ",
        "options": [
          9209,
          822,
          183394,
          2651,
          193738,
          12333
        ],
        "labels": [
          "Ticket to Ride",
          "Carcassonne",
          "Viticulture Essential Edition",
          "Power Grid",
          "Great Western Trail",
          "Twilight Struggle"
        ]
      }
    },
    {
      "name": "showAwards",
      "value": true,
      "bind": {
        "input": "checkbox",
        "name": "Outline Spiel des Jahres winners (1979–2024): "
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 20,
        "color": "#176c7a",
        "opacity": 0.28
      }
    },
    {
      "transform": [
        {
          "filter": "showAwards && isValid(datum.award_year)"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#b65f26",
        "strokeWidth": 2,
        "size": 90
      }
    },
    {
      "transform": [
        {
          "filter": "datum.id === gameFocus"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "fill": "#176c7a",
        "stroke": "#1f3035",
        "strokeWidth": 2,
        "size": 130
      }
    },
    {
      "transform": [
        {
          "filter": "datum.id === gameFocus && gameFocus !== 9209"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -17,
        "fontWeight": 700,
        "stroke": "white",
        "strokeWidth": 3,
        "fill": "#1f3035",
        "align": {
          "expr": "datum.complexity > 3 ? 'right' : 'left'"
        }
      },
      "encoding": {
        "text": {
          "field": "title",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.id === 9209 && gameFocus === 9209"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#176c7a",
        "strokeWidth": 1
      },
      "encoding": {
        "x2": {
          "datum": 1.6
        },
        "y2": {
          "datum": 9.05
        },
        "tooltip": null
      }
    },
    {
      "transform": [
        {
          "filter": "datum.id === 9209 && gameFocus === 9209"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#176c7a"
      },
      "encoding": {
        "x": {
          "datum": 1.12
        },
        "y": {
          "datum": 9.55
        },
        "text": {
          "value": "Ticket to Ride"
        },
        "tooltip": null
      }
    },
    {
      "transform": [
        {
          "filter": "datum.id === 9209 && gameFocus === 9209"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": 400,
        "color": "#176c7a"
      },
      "encoding": {
        "x": {
          "datum": 1.12
        },
        "y": {
          "datum": 9.2
        },
        "text": {
          "value": "Less complex than 84% of these games"
        },
        "tooltip": null
      }
    }
  ],
  "transform": [
    {
      "lookup": "id",
      "from": {
        "data": {
          "url": "./data/award_winners.json"
        },
        "key": "id",
        "fields": [
          "award_year"
        ]
      }
    },
    {
      "calculate": "isValid(datum.award_year) ? 'Spiel des Jahres ' + datum.award_year : 'No main award in 1979–2024'",
      "as": "award_label"
    }
  ],
  "usermeta": {
    "sources": [
      "BoardGameGeek",
      "Spiel des Jahres e.V."
    ],
    "join": "BGG game id to reviewed title matches in data/award_winners.json",
    "awardScope": "Main award, 1979–2024; 14 winners in the 871-game cohort. Rings mark winners; all ratings and complexity values remain BGG measures."
  }
}
