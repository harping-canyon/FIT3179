{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#526369",
      "titleColor": "#526369",
      "gridColor": "#edf0ee"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "font": "Inter"
  },
  "height": 440,
  "data": {
    "url": "./data/country_categories.json"
  },
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelLimit": 140
      },
      "scale": {
        "paddingInner": 0,
        "paddingOuter": 0
      }
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "denominator",
        "op": "max",
        "order": "descending"
      },
      "scale": {
        "paddingInner": 0,
        "paddingOuter": 0
      }
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "numerator",
        "type": "quantitative",
        "title": "Games in category"
      },
      {
        "field": "denominator",
        "type": "quantitative",
        "title": "All country-tagged games"
      },
      {
        "field": "share",
        "type": "quantitative",
        "format": ".1%",
        "title": "Share"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              0.6
            ],
            "scheme": "tealblues"
          },
          "legend": {
            "title": "Share of tagged games",
            "format": ".0%",
            "orient": "bottom",
            "values": [
              0,
              0.2,
              0.4,
              0.6
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "condition": {
            "test": "datum.share >= 0.30",
            "value": "white"
          },
          "value": "#173a43"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.category === 'City Building' && indexof(['Italy','Germany'], datum.country) >= 0"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#1f3035",
        "strokeWidth": 2
      }
    },
    {
      "name": "cell_hit_area",
      "mark": {
        "type": "rect",
        "fill": "transparent",
        "strokeWidth": 0
      }
    }
  ]
}
